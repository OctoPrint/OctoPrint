msgid "Command to restart the system OctoPrint is running on"
msgstr "Commande pour redémarrer le système sur lequel OctoPrint fonctionne"

#: src/octoprint/templates/snippets/settings/server/serverCommandSystemRestart.jinja2:3
msgid "Restart system"
msgstr "Redémarre le système"

#: src/octoprint/templates/snippets/settings/server/serverCommandSystemShutdown.jinja2:2
