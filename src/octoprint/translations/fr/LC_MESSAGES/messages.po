msgstr ""
"Erreur inconnue lors de la vérification si la mise à jour est possible, "
"veuillez vérifier les journaux"

#: src/octoprint/plugins/softwareupdate/static/js/softwareupdate.js:730
#, python-format
msgid ""
"Update not possible under Windows due to its strict file locking behaviour, "
"please <a href=\"%(url)s\" target=\"_blank\">see the FAQ</a>"
msgstr ""
"Mise à jour impossible sous Windows en raison de son comportement strict de "
"verrouillage des fichiers, veuillez <a href=\"%(url)s\" "
"target=\"_blank\">voir la FAQ</a>"

#: src/octoprint/plugins/softwareupdate/static/js/softwareupdate.js:796
msgid "Now updating, please wait."
msgstr "Mise à jour en cours, veuillez patienter."

#: src/octoprint/plugins/softwareupdate/static/js/softwareupdate.js:813
